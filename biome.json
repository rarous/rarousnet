{
  "$schema": "https://biomejs.dev/schemas/2.1.1/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/infrastructure/**",
      "**/scripts/**",
      "**/tests/**",
      "**/workers/**",
      "**/www.rarous.net",
      "!**/www.rarous.net/src/static/assets/js/prism.js",
      "!**/www.rarous.net/src/esm/sha256.js"
    ],
    "ignoreUnknown": false
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "lineWidth": 120,
    "attributePosition": "auto",
    "useEditorconfig": true
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "complexity": {
        "noThisInStatic": "off"
      },
      "style": {
        "useBlockStatements": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "semicolons": "always",
      "arrowParentheses": "asNeeded"
    }
  },
  "css": {
    "formatter": {}
  }
}

{% extends "layouts/weblog.njk" %}

{% set canonicalUrl = weblog.url %}
{% set contentSchema = "Blog" %}

{% block head %}
  {{ super() }}
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ weblog.url }}">
  <meta property="og:title" content="rarouš.weblog">
{% endblock %}

{% block content %}
  <div class="feed" role="feed">
    <article itemprop="blogPost" itemscope itemtype="https://schema.org/BlogPosting">
      <link itemprop="image" href="">
      <header>
        <h2 itemprop="headline"><a itemprop="sameAs" href=""></a></h2>
        <p class="info">
      <span itemscope itemtype="https://schema.org/Person" itemprop="author">
        <strong itemprop="name">Aleš Roubíček</strong>
      </span>
          |
          <time datetime="" itemprop="datePublished"></time>
        </p>
      </header>
      <div itemprop="articleBody"></div>
      <footer data-pagefind-ignore="all">
        Označeno štítky:&nbsp;
        <nav class="tags" aria-label="Štítky">
          <ul>
            <li><a class="p-category" itemprop="articleSection" rel="tag" href="" data-pagefind-filter="tag"></a>
            </li>
          </ul>
        </nav>
        <gryphoon-weblog api-endpoint="{{ weblog.apiEndpoint }}">
          <gryphoon-webmentions>
          <span class="webmentions like-of">
            &nbsp;|&nbsp;Líbilo se&nbsp;<data value=""></data>
          </span>
            <span class="webmentions repost-of">
            &nbsp;|&nbsp;Přeposláno dál&nbsp;<data value=""></data>
          </span>
          </gryphoon-webmentions>

          <gryphoon-comments>
          <span class="comments">
            &nbsp;|&nbsp;Okomentováno&nbsp;<data value=""></data>
          </span>
          </gryphoon-comments>
        </gryphoon-weblog>
      </footer>
    </article>
  </div>

  <div>
    <p>Přihlaš se k odběru:
      <a itemprop="webFeed" href="{{ weblog.articlesFeedUrl }}" type="application/rss+xml">RSS Feed</a>
      · <a href="/weblog/feed/" rel="feed">HTML Feed</a>
    </p>
  </div>
{% endblock %}


          </td>
        </tr>
        </tbody>
      </table>
    </section>
  </form>
{% endblock %}

{% block scripts %}
  <script type="module">
    const form = document.forms.recipe;
    const ingredients = new Map([
      ["water", 87],
      ["salt", 4.5],
      ["dried-yeast", 0.875],
      ["active-yeast", 0.65],
      ["flour", 153.25]
    ]);
    const waterTemps = new Map([
      ["dried", 42],
      ["active", 32],
    ]);

    const { water, waterTemp, salt, yeast, semolina, flour, total } = form.elements;

    function setValue(el, value) {
      if (el instanceof RadioNodeList) {
        for (const x of el) {
          x.value = value;
        }
      } else {
        el.value = value;
      }
    }

    function update(pizzas, semolinaRatio, yeastType) {
      setValue(water, Math.round(pizzas * ingredients.get("water")));
      setValue(waterTemp, waterTemps.get(yeastType));
      setValue(salt, (pizzas * ingredients.get("salt")).toFixed(1));
      setValue(yeast, (pizzas * ingredients.get(`${yeastType}-yeast`)).toFixed(1));
      setValue(semolina, (pizzas * semolinaRatio * ingredients.get("flour")).toFixed(1));
      setValue(flour, Math.round(pizzas * ingredients.get("flour")));
      setValue(total, Math.round(pizzas * ingredients.get("salt") + pizzas * ingredients.get("flour")));
    }

    form.addEventListener("change", e => {
      const data = new FormData(e.target.form);
      const pizzas = Number.parseInt(data.get("pizzas"), 10);
      const semolinaRation = Number.parseFloat(data.get("semolinaRatio"));
      const yeastType = data.get("yeastType");
      update(pizzas, semolinaRation, yeastType);
    });
  </script>
  <script type="module">
    const wakeLockOffButton = document.getElementById("cookingSwitch");
    const shortVersion = document.getElementById("short-version");
    let wakeLock = null;

    async function requestWakeLock() {
      try {
        wakeLock = await navigator.wakeLock.request("screen");
      } catch (err) {
        console.error(err);
      }
    }

    wakeLockOffButton.addEventListener("change", e => {
      if (wakeLock !== null) return;
      requestWakeLock();
    });

    wakeLockOffButton.addEventListener("click", () => {
      if (wakeLock === null) return;
      wakeLock.release().then(() => {
        wakeLock = null;
      });
    });
  </script>
{% endblock %}

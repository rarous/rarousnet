          </td>
        </tr>
        </tbody>
        <tbody>
        <tr>
          <th scope="row">Semolina</th>
          <td>
            <output name="semolina">122,5</output>
             g
          </td>
        </tr>
        <tr>
          <th scope="row">Mouka <q>00</q></th>
          <td>
            <output name="flour">613</output>
             g
          </td>
        </tr>
        <tr>
          <th scope="row">Sůl</th>
          <td>
            <output name="total">631</output>

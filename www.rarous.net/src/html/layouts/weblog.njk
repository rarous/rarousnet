{% extends "layouts/common-layout.njk" %}
{% from "macros/helpers.njk" import sprite %}

{% set images = true %}
{% set title = weblog.title %}
{% set description = weblog.description %}
{% set generator = weblog.generator %}
{% set bodyId = "rarous" %}

{% block head_preconnect %}
  <link rel="preconnect" href="https://static.cloudflareinsights.com">
  <link rel="preconnect" href="https://challenges.cloudflare.com">
{% endblock %}

{% block head_preload %}
  <link rel="preload" as="font" crossorigin="anonymous" type="font/woff2"
        href="/assets/fonts/iosevka/woff2/iosevka-regular.latin.woff2">
  <link rel="preload" as="font" crossorigin="anonymous" type="font/woff2"
        href="/assets/fonts/iosevka/woff2/iosevka-bold.latin.woff2">
  <link rel="preload" as="font" crossorigin="anonymous" type="font/woff2"
        href="/assets/fonts/iosevka/woff2/iosevka-bold.latin-ext.woff2">
  <link rel="preload" as="font" crossorigin="anonymous" type="font/woff2"
        href="/assets/fonts/iosevka/woff2/iosevka-italic.latin.woff2">
  <link rel="preload" as="font" crossorigin="anonymous" type="font/woff2"
        href="/assets/fonts/iosevka/woff2/iosevka-italic.latin-ext.woff2">
{% endblock %}

{% block head_stylesheets %}
  <link rel="stylesheet" href="{{ "iosevka.css" | assetUrl("stylesheets") }}">
  <link rel="stylesheet" href="{{ "blog/blog.css" | assetUrl("stylesheets") }}">
  <link rel="stylesheet" href="/pagefind/pagefind-ui.css">
{% endblock %}

{% block head %}
  <link rel="feed" href="/weblog/feed/">
  <link rel="profile" href="https://gmpg.org/xfn/11">
  <link rel="alternate" type="text/mf2+html" href="/weblog/feed/" title="rarouš.weblog - všechny články">
  <link rel="alternate" type="application/rss+xml" href="{{ weblog.articlesFeedUrl }}"
        title="rarouš.weblog - poslední články">
  <link rel="alternate" type="application/rss+xml" href="https://feeds.feedburner.com/rarous/weblog/comments"
        title="rarouš.weblog - komentáře k článkům">
  <link rel="alternate" type="application/atom+xml" href="https://feeds.feedburner.com/rarous/w3b"
        title="rarouš.w3b - doporučené čtení">
  <meta property="og:site_name" content="rarouš.weblog">
  <meta property="og:locale" content="cs_CZ">
{% endblock %}

{% set headerId = "head" %}
{% block headerContent %}
  <h1 itemprop="headline"><a href="/weblog/" title="Přejít na weblog" translate="no">rarouš.weblog</a></h1>
  <link itemprop="breadcrumb" itemref="breadcrumbs">
{% endblock %}

{% block navbar %}
  <li>
    <a
      href="#hledani"
      title="Hledat na blogu"
      onclick="event.preventDefault();searchDialog.showModal()">
      {{ sprite("search", "Hledat", "0 0 24 24", "feather feather-search") }}
    </a>
  </li>
  <li>
    <a
      href="{{ weblog.articlesFeedUrl }}"
      type="application/rss+xml"
      title="Přihlásit se k odběru pomocí RSS">
      {{ sprite("rss", "Syndikace", "0 0 24 24", "feather feather-rss") }}
    </a>
  </li>
{% endblock %}

{% block dialogs %}
  <dialog id="searchDialog" onclick="event.target === this && this.close()">
    <div id="hledani"></div>
  </dialog>
{% endblock %}

{% block footer %}
  <div class="footer__inner" itemprop="author" itemscope itemtype="https://schema.org/Person">
    <link rel="me" href="/" itemprop="sameAs">
    <nav id="rubriky" class="footer__box" aria-label="Rubriky weblogu">
      <h2>Rubriky</h2>
      <ul>
        <li><a href="/weblog/tag/webdesign.html" title="Vypsat články z rubriky Webdesign">Webdesign</a>
        <li><a href="/weblog/tag/webperf.html" title="Vypsat články z rubriky WebPerf">WebPerf</a>
        <li><a href="/weblog/tag/devops.html" title="Vypsat články z rubriky DevOps">DevOps</a>
        <li><a href="/weblog/tag/cleancode.html" title="Vypsat články z rubriky Čistý kód">Čistý kód</a>
        <li><a href="/weblog/tag/functional.html" title="Vypsat články z rubriky Funkcionální programování">Funkcionální
            programování</a>
        <li><a href="/weblog/tag/ci.html" title="Vypsat články z rubriky Kontinuální integrace">Kontinuální
            integrace</a>
        <li><a href="/weblog/tag/moje-prace.html" title="Vypsat články z rubriky Moje práce">Moje práce</a>
        <li><a href="/weblog/tag/podcast.html" title="Vypsat články z rubriky Podcast">Podcasty</a>
        <li><a href="/weblog/tag/meetup.html" title="Vypsat články z rubriky Meetup">Meetupy</a>
        <li><a href="/weblog/tag/jen-tak.html" title="Vypsat články z rubriky Jen tak">Jen tak</a>
        <li><a href="/weblog/tag/muzika.html" title="Vypsat články z rubriky Muzika">Muzika</a>
      </ul>
    </nav>
    <div id="social" class="footer__box">
      <h2>Profily</h2>
      <ul>
        <li><a itemprop="sameAs" href="https://indieweb.social/@alesroubicek" rel="me">Mastodon</a></li>
        <li><a itemprop="sameAs" href="https://github.com/rarous" rel="me">Github</a></li>
        <li><a itemprop="sameAs" href="https://instagram.com/alesroubicek" rel="me">Instagram</a></li>
        <li><a itemprop="sameAs" href="https://mixcloud.com/alessiobusta" rel="me">Mixcloud</a></li>
        <li><a itemprop="sameAs" href="https://linkedin.com/in/rarous" rel="me">LinkedIn</a></li>
        <li><a itemprop="sameAs" href="https://speakerdeck.com/rarous" rel="me">Speakerdeck</a></li>
        <li><a itemprop="sameAs" href="https://www.goodreads.com/rarous" rel="me">Goodreads</a></li>
        <li><a itemprop="sameAs" href="https://youtube.com/@rarous" rel="me">Youtube</a></li>
      </ul>
    </div>
    <div id="friends" class="footer__box">
      <h2>Přátelé</h2>
      <ul translate="no">
        <li itemprop="knows" itemscope itemtype="https://schema.org/Person">
          <a itemprop="sameAs" href="https://www.izatlouk.cz/pisu"
             rel="sweetheart co-resident met">Irena Zatloukalová</a></li>
        <li itemprop="knows" itemscope itemtype="https://schema.org/Person">
          <a itemprop="sameAs" href="https://veronikamatejkova.com/"
             rel="kin met">Veronika Matějková</a></li>
        <li itemprop="knows" itemscope itemtype="https://schema.org/Person">
          <a itemprop="sameAs" href="https://trnka.digital/"
             rel="friend colleague met">Pavel Trnka</a></li>
        <li itemprop="knows" itemscope itemtype="https://schema.org/Person">
          <a itemprop="sameAs" href="http://maly.in/"
             rel="friend met">Michal Malý</a></li>
        <li itemprop="knows" itemscope itemtype="https://schema.org/Person">
          <a itemprop="sameAs" href="https://fakan.cz/"
             rel="friend colleague met">Daniel Hromada</a></li>
        <li itemprop="knows" itemscope itemtype="https://schema.org/Person">
          <a itemprop="sameAs" href="https://fotkyodveroniky.cz/"
             rel="friend colleague met">Veronika Vajdiaková</a></li>
        <li itemprop="knows" itemscope itemtype="https://schema.org/Person">
          <a itemprop="sameAs" href="https://fczbkk.com/"
             rel="friend colleague met">Riki Fridrich</a></li>
        <li itemprop="knows" itemscope itemtype="https://schema.org/Person">
          <a itemprop="sameAs" href="https://petr.severa.name/"

        <li itemprop="knows" itemscope itemtype="https://schema.org/Person">
          <a itemprop="sameAs" href="https://zezivotarecruiterky.com/"
             rel="friend met">Luu Ly Fabián Nguyen</a></li>
      </ul>
    </div>
    <div id="meetupy" class="footer__box">
      <h2>Meetupy</h2>
      <ul translate="no">
        <li itemprop="memberOf" itemscope itemtype="https://schema.org/Organization">
          <a itemprop="sameAs"
             href="https://www.datamesh.cz/">DATA mesh</a>
        </li>
        <li itemprop="memberOf" itemscope itemtype="https://schema.org/Organization">
          <a itemprop="sameAs"
             href="https://www.meetup.com/webperf-cz/">WebPerf CZ</a>
        </li>
        <li itemprop="memberOf" itemscope itemtype="https://schema.org/Organization">
          <a itemprop="sameAs"
             href="https://frontendisti.cz/">Frontendisti</a>
        </li>
        <li itemprop="memberOf" itemscope itemtype="https://schema.org/Organization">
          <a itemprop="sameAs"
             href="https://www.meetup.com/Lambda-Meetup-Group/">PragueLambda</a>
        </li>
        <li itemprop="memberOf" itemscope itemtype="https://schema.org/Organization">
          <a itemprop="sameAs"
             href="https://caffe.topmonks.cz/">TopMonks Caffè</a>
        </li>
        <li itemprop="memberOf" itemscope itemtype="https://schema.org/Organization">
          <a itemprop="sameAs" href="https://www.meetup.com/fsharping/">Fsharping</a>
        </li>

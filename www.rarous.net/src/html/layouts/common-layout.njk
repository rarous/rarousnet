{% extends "layouts/common-base.njk" %}

{% block body %}
  <div class="wai" id="top">
    <a href="#content" accesskey="0" tabindex="0">Na obsah stránky</a>
  </div>
  <header id="{{ headerId }}">
    {% block headerContent %}{% endblock %}
    <nav aria-label="Hlavní menu">
      <a href="/" title="Přejít na domovskou stránku Aleše Roubíčka">
        <svg class="logo" viewBox="0 0 80 64" width="60" height="43">
          <title>Aleš Roubíček</title>
          <path fill="#b4b4b4"
                d="M20.215 13.222 3.096 52.548H9.88l3.604-8.427h13.462l3.604 8.427h6.731L20.215 13.222M15.869 38.61l4.346-10.229 4.346 10.23h-8.692"/>
          <path fill="#b4b4b4"
                d="M66.304 38.344a11.006 11.006 0 0 0 4.558-3.021c2.067-2.28 3.18-5.46 3.18-9.063 0-3.657-1.113-6.837-3.18-9.116-1.59-1.802-4.611-3.922-9.805-3.922h-11.66v39.325h6.148V39.245h4.505l9.911 13.302h6.943l-10.6-14.203m-10.759-4.611V18.787h5.512c2.544 0 4.452.689 5.671 2.067 1.484 1.59 1.749 3.816 1.749 5.406 0 1.537-.265 3.763-1.749 5.353-1.219 1.378-3.127 2.12-5.671 2.12h-5.512"/>
          <path fill="#b30d00" fill-rule="evenodd" d="M20.333 13.234h39.653v39.544H20.333V13.234z"/>
          <path fill="#fff" fill-rule="evenodd"
                d="m38.796 26.468 1.338-1.246s.992 3.774.92 7.6c-.073 3.826-1.259 7.896-1.259 7.896l-1.181-1.22s.866-3.423.866-6.651c0-3.24-.684-6.379-.684-6.379z"/>
          <path fill="#fff" fill-rule="evenodd"
                d="m41.338 24.1 1.162-1.075s1.655 2.97 1.653 9.75c-.002 5.942-1.961 10.467-1.961 10.467l-1.104-1.158s1.588-4.57 1.588-9.528c0-5.424-1.338-8.456-1.338-8.456z"/>
          <path fill="#fff" fill-rule="evenodd"
                d="m48.437 17.515 1.261-1.172s4.06 5.642 4.06 16.33c0 11.87-4.989 17.43-4.989 17.43l-1.008-1.047s4.521-6.215 4.521-16.601c0-8.905-3.845-14.94-3.845-14.94z"/>
          <path fill="#fff" fill-rule="evenodd"
                d="m43.465 22.131 1.31-1.227s2.456 4.318 2.456 11.563c0 7.232-2.947 12.968-2.947 12.968l-1.124-1.193s2.45-6.118 2.45-11.75c0-6.429-2.145-10.36-2.145-10.36z"/>
          <path fill="#fff" fill-rule="evenodd"
                d="m45.934 19.834 1.297-1.2s3.297 5.373 3.297 13.727c0 10.508-3.893 15.517-3.893 15.517l-1.153-1.216s3.276-5.61 3.32-14.285c.036-7.155-2.868-12.543-2.868-12.543z"/>
          <path fill="#fff" fill-rule="evenodd"
                d="M26.561 30.364c.41-8.172 2.874-14.455 5.831-14.455 3.285 0 6.201 5.913 5.914 16.796-.206 9.24-2.629 16.755-5.914 16.755-2.916 0-5.338-6.037-5.831-13.922l.944-.04.288 1.765 6.652-2.053-.041-4.64-6.611-2.177-.206 1.971h-1.026m9.404-1.273.821-.74s.288 2.506.288 4.477c0 2.423-.657 4.394-.657 4.394l-.657-.698s.369-1.807.369-3.696c0-1.684-.164-3.737-.164-3.737"/>
        </svg>
      </a>
      {% block header %}{% endblock %}
      <ul>
        {% block navbar %}{% endblock %}
        <li>
          <a href="#preferences"
             title="otevřít menu nastavení"
             onclick="event.preventDefault();preferencesDialog.showModal()">
            <svg width="24" height="24" fill="var(--icon-color)" viewBox="0 -960 960 960" style="scale: 0.8">
              <title>Menu nastavení</title>
              <path
                d="M480-800q-33 0-56.5-23.5T400-880q0-33 23.5-56.5T480-960q33 0 56.5 23.5T560-880q0 33-23.5 56.5T480-800ZM360-200v-480q-60-5-122-15t-118-25l20-80q78 21 166 30.5t174 9.5q86 0 174-9.5T820-800l20 80q-56 15-118 25t-122 15v480h-80v-240h-80v240h-80ZM320 0q-17 0-28.5-11.5T280-40q0-17 11.5-28.5T320-80q17 0 28.5 11.5T360-40q0 17-11.5 28.5T320 0Zm160 0q-17 0-28.5-11.5T440-40q0-17 11.5-28.5T480-80q17 0 28.5 11.5T520-40q0 17-11.5 28.5T480 0Zm160 0q-17 0-28.5-11.5T600-40q0-17 11.5-28.5T640-80q17 0 28.5 11.5T680-40q0 17-11.5 28.5T640 0Z"/>
            </svg>
          </a>
        </li>
        <li>
          <a href="#hamburger"
             title="otevřít menu"
             onclick="event.preventDefault();menuDialog.showModal()">
            <svg viewBox="0 0 24 24" fill="var(--icon-color)">
              <title>Hlavní menu</title>
              <path d="M0 0h24v24H0z" fill="none"/>
              <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/>
            </svg>
          </a>
        </li>
      </ul>
    </nav>
  </header>
  <main itemscope itemtype="https://schema.org/{{ contentSchema or "WebPage" }}" id="content"
        {% if contentRole %}role="{{ contentRole }}"{% endif %}
    {% if contentClass %}class="{{ contentClass }}"{% endif %}>
    {% block content %}{% endblock %}
  </main>
  <footer class="footer">
    {% block footer %}{% endblock %}
    <div class="footer__copyright">
      <p>Tento web je postaven na otevřených webových standardech a principech <a href="https://indieweb.org/IndieWeb">indie
          webu</a>,
        běží na <a href="https://pages.dev">Cloudflare Pages</a> a kód je hostován
        <a href="https://github.com/rarous/rarousnet">na Githubu</a>.
      <p itemprop="copyrightNotice">© 2004&ndash;<span class="year">{{ currentYear }}</span>
        <span translate="no">Aleš Roubíček</span>.
        Publikováno pod licencí <a itemprop="license" rel="license" href="https://creativecommons.org/licenses/by-sa/4.0/">CC 4.0 BY-SA</a>.
    </div>
  </footer>
  <dialog id="menuDialog" onclick="event.target === this && this.close()">
    <div id="hamburger">
      <nav aria-label="Navigace po webu">
        <h2>Navigace</h2>
        <ul>
          <li><a href="/">Domovská stránka</a></li>
          <li><a href="/weblog/">Weblog</a></li>
          <li><a href="/kolekce/vinyly">Kolekce vinylů</a></li>
          <li><a href="/w3b/">Doporučené články</a></li>
          <li><a href="/recepty/">Recepty</a></li>
          <li><a href="/o-mne/">O mně</a></li>
          <li><a href="https://hckr.studio/" translate="no">hckr.studio</a></li>
        </ul>
      </nav>
    </div>
  </dialog>
  <dialog id="preferencesDialog" onclick="event.target === this && this.close()">
    <script type="module" src="{{ "settings-form.js" | assetUrl("esm") }}"></script>
    <settings-form id="preferences">
      <form method="dialog">
        <h2>Nastavení</h2>
        <fieldset class="theme">
          <legend>Barevné schéma</legend>
          <ul>
            <li><label><input type="radio" name="color-scheme" value="normal" checked> Automaticky</label></li>
            <li><label><input type="radio" name="color-scheme" value="light"> Světlé</label></li>
            <li><label><input type="radio" name="color-scheme" value="dark"> Tmavé</label></li>
          </ul>
        </fieldset>
        <fieldset class="fonts">
          <legend>Rodina fontů</legend>
          <div class="columns">
            <section>
              <h3>rarouš default</h3>
              <ul lang="en">
                <li><label style="font-family: var(--innovator-grotesk)"><input type="radio" name="--main-font"
                                                                                value="var(--innovator-grotesk)"
                                                                                checked>
                    Innovator Grotesk</label></li>
              </ul>
              <h3 lang="en">User agent default</h3>
              <ul lang="en">
                <li><label style="font-family: serif"><input type="radio" name="--main-font" value="serif">serif</label>
                </li>
                <li><label style="font-family: sans-serif"><input type="radio" name="--main-font" value="sans-serif">sans-serif</label>
                </li>
              </ul>
              <h3>Přístupnější fonty</h3>
              <ul>
                <li><label style="font-family: var(--atkinson-hyperlegible)"><input type="radio" name="--main-font"
                                                                                    value="var(--atkinson-hyperlegible)">
                    Atkinson Hyperlegible</label></li>
                <li><label style="font-family: var(--andika)"><input type="radio" name="--main-font"
                                                                     value="var(--andika)">
                    Andika</label></li>
                <li><label style="font-family: var(--lexend)"><input type="radio" name="--main-font"
                                                                     value="var(--lexend)">
                    Lexend</label></li>
                <li><label style="font-family: var(--opendyslexic)"><input type="radio" name="--main-font"
                                                                           value="var(--opendyslexic)">
                    OpenDyslexic</label></li>
              </ul>
            </section>
            <section lang="en">
              <h3><a href="https://moderfontstacks.com/">Modern font stacks</a></h3>
              <ul>
                <li><label style="font-family: var(--font-system-ui)"><input type="radio" name="--main-font"
                                                                             value="var(--font-system-ui)">
                    System UI</label></li>
                <li><label style="font-family: var(--font-serif)"><input type="radio" name="--main-font"
                                                                         value="var(--font-serif)">
                    UI Serif</label></li>
                <li><label style="font-family: var(--font-transitional)"><input type="radio" name="--main-font"
                                                                                value="var(--font-transitional)">
                    Transitional</label></li>
                <li><label style="font-family: var(--font-old-style)"><input type="radio" name="--main-font"
                                                                             value="var(--font-old-style)">
                    Old style</label></li>
                <li><label style="font-family: var(--font-humanist)"><input type="radio" name="--main-font"
                                                                            value="var(--font-humanist)">
                    Humanist</label></li>
                <li><label style="font-family: var(--font-geometric-humanist)"><input type="radio" name="--main-font"
                                                                                      value="var(--font-geometric-humanist)">
                    Geometric Humanist</label></li>
                <li><label style="font-family: var(--font-classical-humanist)"><input type="radio" name="--main-font"
                                                                                      value="var(--font-classical-humanist)">
                    Classical Humanist</label></li>
                <li><label style="font-family: var(--font-neo-grotesque)"><input type="radio" name="--main-font"
                                                                                 value="var(--font-neo-grotesque)">
                    Neo Grotesque</label></li>
                <li><label style="font-family: var(--font-industrial)"><input type="radio" name="--main-font"
                                                                              value="var(--font-industrial)">
                    Industrial</label></li>
                <li><label style="font-family: var(--font-rounded-sans)"><input type="radio" name="--main-font"
                                                                                value="var(--font-rounded-sans)">
                    Rounded Sans</label></li>
                <li><label style="font-family: var(--font-slab-serif)"><input type="radio" name="--main-font"
                                                                              value="var(--font-slab-serif)">
                    Slab Serif</label></li>
                <li><label style="font-family: var(--font-antique)"><input type="radio" name="--main-font"
                                                                           value="var(--font-antique)">
                    Antique</label></li>
                <li><label style="font-family: var(--font-didone)"><input type="radio" name="--main-font"
                                                                          value="var(--font-didone)">
                    Didone</label></li>
                <li><label style="font-family: var(--font-handwritten)"><input type="radio" name="--main-font"
                                                                               value="var(--font-handwritten)">
                    Handwritten</label></li>
              </ul>
            </section>
          </div>
        </fieldset>
        <div>
          <button>Uložit</button>
        </div>
      </form>
    </settings-form>
  </dialog>
  {% block dialogs %}{% endblock %}
  <script type="module">
    if (!window.HTMLDialogElement) {
      // <dialog> polyfill
      await import("https://cdn.jsdelivr.net/gh/nuxodin/dialog-polyfill@1.4.2/dialog.min.js");
    }
  </script>
{% endblock %}

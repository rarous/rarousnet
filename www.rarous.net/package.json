{
  "name": "@rarousnet/website",
  "packageManager": "yarn@4.6.0",
  "exports": {
    "./*": "./src/esm/*"
  },
  "dependencies": {
    "@thi.ng/transducers": "9.2.16"
  },
  "devDependencies": {
    "@hckr_/blendid": "9.2.2",
    "@types/gulp": "4.0.17",
    "@types/undertaker-registry": "1.0.4",
    "open-props": "1.7.10",
    "pagefind": "1.3.0",
    "postcss-jit-props": "1.0.15",
    "undertaker-registry": "2.0.0",
    "wrangler": "3.105.1"
  },
  "resolutions": {
    "esbuild": "0.24.2"
  },
  "scripts": {
    "build": "blendid build --production",
    "build:index": "pagefind --site ../.gryphoon/dist",
    "start": "blendid",
    "deploy": "wrangler pages deploy ../.gryphoon/dist --project-name=rarousnet --upload-source-maps"
  }
}

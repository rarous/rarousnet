{
  "name": "@rarousnet/website",
  "packageManager": "yarn@4.7.0",
  "exports": {
    "./*": "./src/esm/*"
  },
  "dependencies": {
    "@thi.ng/transducers": "9.2.22"
  },
  "devDependencies": {
    "@hckr_/blendid": "9.3.2",
    "@types/gulp": "4.0.17",
    "@types/undertaker-registry": "1.0.4",
    "open-props": "1.7.13",
    "pagefind": "1.3.0",
    "postcss-jit-props": "1.0.16",
    "undertaker-registry": "2.0.0",
    "wrangler": "3.114.1"
  },
  "resolutions": {
    "esbuild": "0.25.1"
  },
  "scripts": {
    "build": "blendid build --production",
    "build:index": "pagefind --site ../.gryphoon/dist",
    "start": "blendid",
    "deploy": "wrangler pages deploy ../.gryphoon/dist --project-name=rarousnet --upload-source-maps --version"
  }
}
